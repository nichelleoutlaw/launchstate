# Frontend (Vite, exposed to browser at build time)
# Leave blank to use same-origin requests in local combined dev.
VITE_API_BASE_URL=

# Backend (Express server only; never expose secrets to frontend)
GEMINI_API_KEY=your_gemini_api_key_here
# Comma-separated list of allowed frontend origins for CORS.
FRONTEND_ORIGIN=http://localhost:5173,https://launchstatellc.me
# Optional locally. Render/Railway/Fly usually inject this automatically.
PORT=3000
